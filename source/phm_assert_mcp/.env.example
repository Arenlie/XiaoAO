APP_NAME=phm-asset-mcp
APP_ENV=production
HOST=0.0.0.0
PORT=9534
MCP_PATH=/mcp
LOG_LEVEL=INFO

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_COMMAND_TIMEOUT=10

# Confirmed by the uploaded Dify YML.
ASSET_CATALOG_TABLE=public.entity_search_catalog
ASSET_NORMALIZE_FUNCTION=normalize_entity_name

# catalog_path: derive hierarchy deterministically from metadata.space_link.
# native_recursive: use a configured raw space table and PostgreSQL Recursive CTE.
ASSET_HIERARCHY_BACKEND=catalog_path

# Only required when ASSET_HIERARCHY_BACKEND=native_recursive.
SPACE_TABLE=
SPACE_ID_COLUMN=
SPACE_PARENT_ID_COLUMN=
SPACE_NAME_COLUMN=
SPACE_TYPE_COLUMN=
SPACE_NO_COLUMN=

ASSET_TREE_MAX_DEPTH=10
ASSET_TREE_MAX_NODES=5000
ASSET_QUERY_MAX_DEVICES=5000
ASSET_QUERY_MAX_POINTS=5000
# 区域下属集合展开时，跨设备读取测点的最大并发数。
ASSET_COLLECTION_MAX_PARALLEL=8

ASSET_CACHE_ENABLED=true
ASSET_CACHE_TTL_SECONDS=300

# Required OpenAI-compatible embedding endpoint used for all natural-language recall.
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:9998
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=10

# Required reranker used to validate and sort real pgvector candidates.
RERANK_ENABLED=true
RERANK_BASE_URL=http://127.0.0.1:9998
RERANK_API_KEY=
RERANK_MODEL=Qwen3-Reranker-0.6B
RERANK_TIMEOUT=10

# Required Asset parameter extraction model. install.sh copies the Conversation
# SUPERVISOR key/base URL when these values are empty; facts still come from PostgreSQL.
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.6-flash
LLM_TIMEOUT=30

# Candidates below this combined Embedding/Reranker relevance are discarded.
# Score gaps never auto-select a candidate.
RESOLVE_CANDIDATE_MIN_SCORE=0.20
RESOLVE_MAX_CANDIDATES=40

# dual returns the new MCP contract plus legacy-compatible fields.
RESOLVE_OUTPUT_COMPAT_MODE=dual

# 可观测性：关闭时不生成 MCP 内部性能明细，业务功能不受影响。
PERFORMANCE_MONITOR_ENABLED=true
PERFORMANCE_TRACE_MAX_SPANS=120

# Complete collection pagination
ASSET_COLLECTION_PAGE_SIZE=1000
ASSET_COLLECTION_MAX_ITEMS=50000
ASSET_COLLECTION_MAX_PARALLEL=8

# 1.1: only model computations are cached; asset identities are always queried live.
MODEL_CACHE_MAX_ENTRIES=512
EMBEDDING_CACHE_TTL_SECONDS=3600
UNDERSTANDING_CACHE_TTL_SECONDS=120
MODEL_HTTP_MAX_CONNECTIONS=40

# Sensor queries 1.2.0
SENSOR_AGENT_ENABLED=true
SENSOR_AGENT_BASE_URL=http://10.10.47.231:9528
SENSOR_AGENT_TIMEOUT_SECONDS=8
SENSOR_AGENT_MAX_RETRIES=1
SENSOR_AGENT_VERIFY_TLS=true
SENSOR_AGENT_AUTH_HEADER=Authorization
SENSOR_AGENT_AUTH_VALUE=
SENSOR_AGENT_TIMEZONE=Asia/Shanghai
SENSOR_AGENT_MAX_PARALLEL=4
SENSOR_AGENT_CACHE_TTL_SECONDS=10
SENSOR_AGENT_RULES_CACHE_TTL_SECONDS=300
SENSOR_AGENT_SCOPE_MAX_POINTS=200
SENSOR_AGENT_SCOPE_TIMEOUT_SECONDS=25
SENSOR_AGENT_MAX_RESPONSE_MB=64

SENSOR_AGENT_FETCH_LIMIT=15000
SENSOR_AGENT_REGISTRY_MAPPING_TTL_SECONDS=300

# Evidence-backed asset snapshots: physical historical retention (10 years).
ASSET_QUERY_SNAPSHOT_RETENTION_SECONDS=315576000
