# Application
APP_NAME=conversation-management
APP_VERSION=1.7.0
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8032
BUSINESS_TIMEZONE=Asia/Shanghai
API_PREFIX=/chat/v1
DEFAULT_EXECUTION_MODE=normal
LANGGRAPH_CHECKPOINT_ENABLED=false
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_SETUP_ON_START=false

# QuickGraph: GeneralContentAgent, exactly one model call
QUICK_MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QUICK_MODEL_API_KEY=replace-me
QUICK_MODEL=qwen3.7-plus
QUICK_VISION_MODEL=qwen3.7-plus
QUICK_TIMEOUT_SECONDS=60
QUICK_ENABLE_REASONING=false
QUICK_REASONING_EFFORT=low
REASONING_API_MODE=chat_enable_thinking

# NormalGraph supervisor
SUPERVISOR_MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SUPERVISOR_MODEL_API_KEY=replace-me
SUPERVISOR_MODEL=qwen3.7-plus
SUPERVISOR_TIMEOUT_SECONDS=300
NORMAL_MAX_EXECUTION_STEPS=15
NORMAL_RECIPE_MIN_CONFIDENCE=0.92
NORMAL_DIAGNOSIS_GATE_CONFIDENCE=0.90
SUPERVISOR_CLASSIFICATION_MAX_ATTEMPTS=3
# Only the short routing/intake calls disable thinking; planning/synthesis retain their profile.
SUPERVISOR_CLASSIFICATION_ENABLE_REASONING=false
SUPERVISOR_CLASSIFICATION_TIMEOUT_SECONDS=45
SUPERVISOR_EARLY_ENTITY_ENABLED=true
SUPERVISOR_EARLY_ENTITY_TIMEOUT_SECONDS=8
SUPERVISOR_EARLY_ENTITY_MAX_PARALLEL=4
NORMAL_MAX_AGENT_CALLS=12
NORMAL_MAX_PARALLEL_CALLS=18

# Native image/file understanding
MULTIMODAL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MULTIMODAL_API_KEY=replace-me
MULTIMODAL_MODEL=qwen3.7-plus
MULTIMODAL_TIMEOUT_SECONDS=180
MULTIMODAL_PDF_DETAIL=high

# Agent resilience
AGENT_DEFAULT_TIMEOUT_SECONDS=300
AGENT_DEFAULT_MAX_RETRIES=2
AGENT_RETRY_BASE_DELAY_SECONDS=1
AGENT_RETRY_MAX_DELAY_SECONDS=8
AGENT_CIRCUIT_BREAKER_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_RESET_SECONDS=60
AGENT_REGISTRY_CACHE_TTL_SECONDS=30
CONTROLLER_ADMIN_TOKEN=replace-me

# File processing
CONTENT_UNDERSTANDING_MAX_CHARACTERS_PER_ATTACHMENT=12000
CONTENT_UNDERSTANDING_MAX_TOTAL_CHARACTERS=36000
FILE_QUICK_MAX_CHARACTERS=30000
FILE_STANDARD_MAX_CHARACTERS=200000
FILE_RETRIEVAL_CHUNK_SIZE=1500
FILE_RETRIEVAL_CHUNK_OVERLAP=200
FILE_ALLOW_NATIVE_MODEL_UPLOAD=true
FILE_EXTERNAL_MODEL_POLICY=ALLOW_NATIVE_FILE
FILE_ENABLE_VECTOR_INDEX=false
FILE_ENABLE_ANTIVIRUS_SCAN=false
SPREADSHEET_TOOL_MAX_SCAN_ROWS=100000

# Attachment storage
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_DIR=./data/attachments
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_MAX_TOTAL_BYTES_PER_MESSAGE=52428800
ATTACHMENT_MAX_COUNT_PER_MESSAGE=6
ATTACHMENT_UNBOUND_TTL_SECONDS=86400
ATTACHMENT_MAX_UNBOUND_COUNT_PER_USER=20
ATTACHMENT_MAX_UNBOUND_BYTES_PER_USER=209715200
ATTACHMENT_MAX_STORAGE_BYTES_PER_USER=1073741824
ATTACHMENT_ALLOW_OTHER_TYPES=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_REGION=
MINIO_ATTACHMENT_BUCKET=conversation-attachments

# PostgreSQL and Redis
DATABASE_URL=postgresql+asyncpg://chat:replace-me@127.0.0.1:5432/chat_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=10
POSTGRESQL_RLS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT_SECONDS=15
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_STREAM_BLOCK_MS=3000

# Legacy Dify entity Workflow (inactive; accepted only for old deployment compatibility)
ENTITY_WORKFLOW_BASE_URL=
ENTITY_WORKFLOW_API_KEY=
ENTITY_WORKFLOW_TIMEOUT_SECONDS=120
ENTITY_CONNECT_TIMEOUT_SECONDS=2
ENTITY_LOOKUP_CACHE_TTL_SECONDS=0
ENTITY_PROFILE_INPUT_NAME=user_profile
ENTITY_PROFILE_MAX_CHARACTERS=12000

# Standalone ASR (speech-to-text)
# Public DashScope mode (default). Never hard-code the API key in source code.
ASR_ENABLED=true
ASR_PROVIDER=dashscope
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=replace-me
ASR_MODEL=qwen3-asr-flash
ASR_TIMEOUT_SECONDS=90
ASR_MAX_FILE_BYTES=10485760
ASR_DEFAULT_LANGUAGE=zh
ASR_ENABLE_ITN=false
# Optional industrial vocabulary/context, e.g. 第一炼钢事业部,15精轧机,轧机,轴承,振动,温度
ASR_CONTEXT=

# Realtime ASR WebSocket. Browser audio stays on your backend first; the backend
# proxies PCM16/16kHz to DashScope so no cloud API key is exposed to JavaScript.
ASR_REALTIME_ENABLED=true
ASR_REALTIME_PROVIDER=dashscope
ASR_REALTIME_PROTOCOL=qwen_audio_streaming
ASR_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# Leave blank to reuse ASR_API_KEY.
ASR_REALTIME_API_KEY=
# Optional Workspace ID. For the recommended Workspace-specific endpoint, set
# ASR_REALTIME_BASE_URL to the matching Beijing/Singapore wss URL.
ASR_REALTIME_WORKSPACE_ID=
ASR_REALTIME_MODEL=qwen-audio-3.0-asr-flash-streaming
ASR_REALTIME_CONNECT_TIMEOUT_SECONDS=15
ASR_REALTIME_FINISH_TIMEOUT_SECONDS=12
ASR_REALTIME_HOTWORDS=
ASR_REALTIME_HOTWORD_WEIGHT=4
ASR_REALTIME_MAX_SENTENCE_SILENCE_MS=400
ASR_REALTIME_VAD_THRESHOLD=0.0
ASR_REALTIME_SILENCE_DURATION_MS=400

# Local OpenAI-compatible Qwen3-ASR example (vLLM):
# ASR_PROVIDER=openai_compatible
# ASR_BASE_URL=http://127.0.0.1:8000/v1
# ASR_API_KEY=EMPTY
# ASR_MODEL=Qwen/Qwen3-ASR-0.6B

# PHM Data MCP 1.0.0 (same-server Streamable HTTP)
# PHM Asset MCP: the single entity decision/fuzzy lookup/hierarchy owner.
PHM_ASSET_MCP_ENABLED=true
PHM_ASSET_MCP_URL=http://127.0.0.1:9534/mcp
PHM_ASSET_MCP_TIMEOUT_SECONDS=60
PHM_ASSET_MCP_VERIFY_TOOLS_ON_START=false

PHM_DATA_MCP_ENABLED=true
PHM_DATA_MCP_URL=http://127.0.0.1:9531/mcp
PHM_DATA_MCP_TIMEOUT_SECONDS=120
PHM_DATA_MCP_VERIFY_TOOLS_ON_START=false

PHM_DIAGNOSIS_MCP_ENABLED=true
PHM_DIAGNOSIS_MCP_URL=http://127.0.0.1:9532/mcp
PHM_DIAGNOSIS_MCP_TIMEOUT_SECONDS=120
PHM_DIAGNOSIS_MCP_VERIFY_TOOLS_ON_START=false

PHM_FEATURE_MCP_ENABLED=true
PHM_FEATURE_MCP_URL=http://127.0.0.1:9533/mcp
PHM_FEATURE_MCP_FEATURE_TIMEOUT_SECONDS=30
PHM_FEATURE_MCP_RPM_TIMEOUT_SECONDS=45
PHM_FEATURE_MCP_VERIFY_TOOLS_ON_START=false
PHM_FEATURE_BATCH_MAX_PARALLEL=4
PHM_FEATURE_QUEUE_RETRY_ATTEMPTS=2
PHM_FEATURE_QUEUE_RETRY_DELAY_SECONDS=4

# Dify comprehensive alarm Workflow (database-only)
COMPREHENSIVE_ALARM_WORKFLOW_ENABLED=false
COMPREHENSIVE_ALARM_WORKFLOW_BASE_URL=http://10.10.47.231/v1
COMPREHENSIVE_ALARM_WORKFLOW_API_KEY=replace-me
COMPREHENSIVE_ALARM_WORKFLOW_TIMEOUT_SECONDS=180
COMPREHENSIVE_ALARM_CONNECT_TIMEOUT_SECONDS=2

# Reserved legacy XiaoAo assistant. Kept disabled until its role is defined.
LEGACY_AI_DIAGNOSIS_ENABLED=false
LEGACY_XIAOAO_ENABLED=false

# Dify AI diagnosis and industrial data agents
AGENT_BASE_URL=http://10.10.47.231/v1
AGENT_API_KEY=replace-me
AGENT_TIMEOUT_SECONDS=600
AGENT_CONNECT_TIMEOUT_SECONDS=2
AGENT_MAX_CONNECTIONS=100
AGENT_MAX_KEEPALIVE_CONNECTIONS=40
AGENT_KEEPALIVE_EXPIRY_SECONDS=60
AGENT_HTTP2=false

# Conversation title
TITLE_MODE=dify
TITLE_DIFY_BASE_URL=http://10.10.47.231/v1
TITLE_DIFY_API_KEY=replace-me
TITLE_TIMEOUT_SECONDS=20

# Runtime and queues
MAX_ACTIVE_GENERATIONS_PER_CONVERSATION=1
MAX_ACTIVE_GENERATIONS_PER_USER=3
MAX_ACTIVE_GENERATIONS_GLOBAL=30
TASK_CONTEXT_TTL_SECONDS=1800
ENTITY_SELECTION_TTL_SECONDS=900
TASK_EVENT_TTL_SECONDS=3600
TASK_EVENT_MAXLEN=5000
SSE_HEARTBEAT_SECONDS=2
SSE_XREAD_BLOCK_MS=1000
SSE_REDIS_RETRY_SECONDS=1
SSE_CLIENT_RETRY_MS=1500
GENERATION_QUEUE_BLOCK_MS=1000
GENERATION_QUEUE_BATCH_SIZE=4
WORKER_CONCURRENCY=12
WORKER_HEARTBEAT_SECONDS=10

# Retention and memory
CONVERSATION_RETENTION_DAYS=365
DELETED_CONVERSATION_PURGE_DAYS=3
CONTEXT_RECENT_MESSAGE_LIMIT=12
CONTEXT_MAX_CHARACTERS=16000
SUMMARY_TRIGGER_MESSAGE_COUNT=10

# Outbox
OUTBOX_ENABLED=true
OUTBOX_FAST_PUBLISH_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=0.1
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_LOCK_TIMEOUT_SECONDS=60
OUTBOX_BASE_RETRY_SECONDS=0.5
OUTBOX_MAX_RETRY_SECONDS=60

# Logging, CORS, telemetry
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
LOG_RETENTION_DAYS=30
ALLOW_CORS_ORIGINS='["*"]'
OTEL_ENABLED=false
OTEL_SERVICE_NAME=conversation-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_CONSOLE_EXPORTER=false
OTEL_EXCLUDED_URLS=/health,/ready,/metrics

# Whole-device PHM MCP timeout budgets
PHM_DATA_MCP_DEVICE_TIMEOUT_SECONDS=300
PHM_DATA_MCP_CLOSE_TIMEOUT_SECONDS=5
PHM_DIAGNOSIS_MCP_DEVICE_TIMEOUT_SECONDS=300

# ===== 对话全链路性能监控 =====
# PERFORMANCE_MONITOR_ENABLED=true 时会产生细粒度 performance.* 事件；关闭后仅保留原有业务事件和 MCP 总调用耗时。
PERFORMANCE_MONITOR_ENABLED=true
# 单独控制是否在每次问题结束后生成服务器端完整性能汇总日志；默认关闭，不通过前端接口/SSE传输。
PERFORMANCE_REPORT_ENABLED=false
PERFORMANCE_TRACE_INCLUDE_MCP_DETAILS=true
PERFORMANCE_TRACE_MAX_MCP_SPANS=120
PERFORMANCE_TRACE_PREVIEW_CHARS=500

# 1.1 Dify Knowledge: keep the real key in .env only.
DIFY_KNOWLEDGE_ENABLED=true
DIFY_KNOWLEDGE_BASE_URL=http://10.10.47.231/v1
DIFY_KNOWLEDGE_API_KEY=
DIFY_KNOWLEDGE_DATASET_IDS={}
DIFY_KNOWLEDGE_RETRIEVAL_MODEL={}
DIFY_KNOWLEDGE_TIMEOUT_SECONDS=20
DIFY_KNOWLEDGE_CATALOG_TTL_SECONDS=300
DIFY_KNOWLEDGE_MAX_PARALLEL=3
DIFY_KNOWLEDGE_TOP_K=3
DIFY_KNOWLEDGE_MAX_SEGMENT_CHARACTERS=2500
DIFY_KNOWLEDGE_AUTO_ENRICH=true
DIFY_KNOWLEDGE_ENRICHMENT_TIMEOUT_SECONDS=8

# Sensor queries 1.2.0
PHM_SENSOR_TOOLS_ENABLED=true

# New 1.4.0 settings; append only, never replace existing values.
MODEL_REASONING_PARAMETERS=auto
SUPERVISOR_ENABLE_REASONING=true
STREAM_REASONING_ENABLED=true
ANSWER_STREAM_FLUSH_SECONDS=0.08
DIAGNOSIS_CONFIRMATION_TTL_SECONDS=900

# Evidence Fabric v1 (all have safe code defaults; explicit values aid operations)
EVIDENCE_FABRIC_ENABLED=true
EVIDENCE_DUAL_WRITE_ENABLED=true
EVIDENCE_INLINE_MAX_BYTES=65536
EVIDENCE_MAX_ROWS_PER_SLICE=200
EVIDENCE_MAX_TEXT_CHARS=16000
EVIDENCE_MAX_TOKENS_PER_SLICE=8000
EVIDENCE_CATALOG_MAX_ITEMS=64
EVIDENCE_COLD_SEARCH_CANDIDATES=5
EVIDENCE_COLD_SEARCH_SCAN_LIMIT=80
