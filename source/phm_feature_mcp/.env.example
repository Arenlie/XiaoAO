SERVICE_NAME=phm_feature_mcp
SERVICE_VERSION=1.0.0
ALGORITHM_VERSION=mechanic-dual-spectrum-1.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=9533
MCP_PATH=/mcp
WEB_CONCURRENCY=2
MAX_REQUEST_BODY_SIZE=33554432
MAX_WORKERS=2
MAX_CONCURRENT_TASKS=4
QUEUE_WAIT_TIMEOUT_S=60
MAX_SAMPLES_PER_REQUEST=262144
MIN_SAMPLES_PER_REQUEST=256
MIN_FINITE_RATIO=0.98
ENABLE_LLM_JUDGE=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=15
LOG_LEVEL=INFO
LOG_JSON=true
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# 可观测性：关闭时不生成 MCP 内部性能明细，业务功能不受影响。
PERFORMANCE_MONITOR_ENABLED=true
PERFORMANCE_TRACE_MAX_SPANS=120
