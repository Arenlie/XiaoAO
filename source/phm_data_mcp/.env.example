APP_NAME=phm-data-mcp
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=9531
TIMEZONE=Asia/Shanghai
QUERY_TIMEOUT_SECONDS=45

MONGO_URI=mongodb://127.0.0.1:27017/phm2
MONGO_DB=phm2
MONGO_QUERY_MAX_TIME_MS=45000
MONGO_READ_PREFERENCE=nearest
MONGO_SERVER_SELECTION_TIMEOUT_SECONDS=15
MONGO_CONNECT_TIMEOUT_SECONDS=10
MONGO_SOCKET_TIMEOUT_SECONDS=90
MONGO_READ_RETRY_ATTEMPTS=3
MONGO_READ_RETRY_BACKOFF_SECONDS=0.35

HEALTH_MONGO_URI=mongodb://10.10.47.232:27017,10.10.47.233:27017,10.10.47.234:27017/phm2
HEALTH_MONGO_DB=phm2
HEALTH_REDIS_HOST=10.10.47.226
HEALTH_REDIS_PORT=6379
HEALTH_REDIS_DB=10

MYSQL_HOST=10.10.47.226
MYSQL_PORT=3306
MYSQL_DATABASE=phm2_test
MYSQL_USER=root
MYSQL_PASSWORD=

AUDIT_ENABLED=true
AUDIT_DATABASE_URL=postgresql://phm_data_mcp:123456@127.0.0.1:5432/phm_data_mcp
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=1000000
AUDIT_MAX_JSON_BYTES=65536

TREND_INLINE_MAX_POINTS=5000
MAX_RESPONSE_BYTES=67108864
WAVEFORM_MAX_SAMPLES=2000000
TREND_MAX_POINTS=2000000

# Only complex alarm statistics use this optional SQL planner.
ALARM_LLM_ENABLED=false
ALARM_LLM_BASE_URL=
ALARM_LLM_API_KEY=
ALARM_LLM_MODEL=
ALARM_LLM_TIMEOUT_SECONDS=60

# Whole-device payload adaptation (1.1.6)
DEVICE_RESPONSE_BUDGET_RATIO=0.85
DEVICE_TREND_FALLBACK_DAYS=7,1

# 可观测性：关闭时不生成 MCP 内部性能明细，业务功能不受影响。
PERFORMANCE_MONITOR_ENABLED=true
PERFORMANCE_TRACE_MAX_SPANS=120
